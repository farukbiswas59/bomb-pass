# Vite dev uses the local proxy. Production defaults are in .env.production.
# To override the production backend, set before build:
# VITE_SERVER_URL=https://your-realtime-server.example
PORT=3001
HOST=0.0.0.0
# Required for production; comma-separated exact frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
MAX_ROOMS=200

# APK defaults to https://bomb-pass-ugre.onrender.com via .env.production.
# Online backend ALLOWED_ORIGINS must include http://localhost for the APK.
# Render production value (keep all origins on one comma-separated line):
# ALLOWED_ORIGINS=https://bomb-pass-puce.vercel.app,https://bomb-pass-ugre.onrender.com,http://localhost
# VITE_PUBLIC_URL=https://your-game.vercel.app
